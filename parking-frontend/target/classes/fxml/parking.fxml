<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.PaymentController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Payments" onAction="#goToPayment" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="15" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Payment Methods"/>
            <Label style="-fx-text-fill: gray; -fx-font-size: 12px;" text="This is a demo page - no real payments are processed"/>

            <Label text="Saved Cards" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="No saved payment methods yet." style="-fx-text-fill: gray;"/>

            <Label text="Add a Card (Demo)" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <fx:define>
                <ToggleGroup fx:id="cardTypeGroup"/>
            </fx:define>

            <RadioButton text="Credit Card" toggleGroup="$cardTypeGroup" selected="true"/>
            <RadioButton text="Debit Card" toggleGroup="$cardTypeGroup"/>
            <RadioButton text="UPI" toggleGroup="$cardTypeGroup"/>

            <TextField fx:id="cardNumberField" promptText="Card / UPI Number (demo only)" maxWidth="300"/>
            <TextField fx:id="cardNameField" promptText="Name on Card" maxWidth="300"/>

            <Button text="Save Payment Method (Demo)" onAction="#handleSaveCard"/>

            <Label fx:id="statusLabel" style="-fx-text-fill: green;" text=""/>

        </VBox>
    </center>

</BorderPane>