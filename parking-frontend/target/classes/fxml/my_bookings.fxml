<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.parking.client.controller.MyBookingsController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="My Bookings" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <ListView fx:id="bookingListView" prefHeight="250" prefWidth="450"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" text=""/>
    <Label fx:id="successLabel" style="-fx-text-fill: green;" text=""/>

    <Button text="Complete Selected (Exit Vehicle)" onAction="#handleComplete"/>
    <Button text="Cancel Selected Booking" onAction="#handleCancel"/>
    <Button text="Refresh" onAction="#loadBookings"/>

    <Button text="Back to Dashboard" onAction="#goToDashboard"/>
</VBox>