<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.parking.client.controller.LoginController"
           stylesheets="@../css/styles.css"
           styleClass="main-layout">

    <VBox alignment="CENTER" spacing="18" styleClass="auth-card" maxWidth="380">
        <padding>
            <Insets top="10" bottom="10"/>
        </padding>

        <HBox styleClass="brand-badge" alignment="CENTER">
            <Label text="P"/>
        </HBox>

        <Label text="Welcome back" styleClass="auth-title"/>
        <Label text="Log in to manage your parking" styleClass="auth-subtitle"/>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="EMAIL" styleClass="auth-field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="PASSWORD" styleClass="auth-field-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" text="" wrapText="true"/>

        <Button text="Log In" onAction="#handleLogin" maxWidth="Infinity"/>

        <Label text="Forgot Password?" styleClass="auth-link" onMouseClicked="#goToForgotPassword"/>

        <HBox alignment="CENTER" spacing="4">
            <Label text="New here?" style="-fx-font-size: 12px; -fx-text-fill: #8891a5;"/>
            <Label text="Create an account" styleClass="auth-link" onMouseClicked="#goToSignup"/>
        </HBox>
<Button fx:id="loginButton" text="Log In" onAction="#handleLogin" maxWidth="Infinity"/>
    </VBox>

</StackPane>