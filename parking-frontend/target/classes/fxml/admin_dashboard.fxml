<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.AdminDashboardController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn, sidebar-btn-admin-active" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="10" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="welcomeLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Admin Dashboard"/>

            <Label text="Revenue Overview" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label fx:id="revenueLabel" text="Loading..."/>
            <Button text="Refresh Report" onAction="#loadRevenue" styleClass="admin-btn"/>

            <Separator/>

            <Label text="Manage Staff" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <TextField fx:id="staffNameField" promptText="Name" maxWidth="250"/>
            <TextField fx:id="staffEmailField" promptText="Email" maxWidth="250"/>
            <PasswordField fx:id="staffPasswordField" promptText="Password" maxWidth="250"/>
            <TextField fx:id="staffPhoneField" promptText="Phone" maxWidth="250"/>
            <Button text="Add Staff" onAction="#handleAddStaff" styleClass="admin-btn"/>
            <Label fx:id="staffStatusLabel" text=""/>

            <ListView fx:id="staffListView" prefHeight="120" prefWidth="450"/>
            <Button text="Remove Selected Staff" onAction="#handleRemoveStaff" styleClass="admin-btn"/>

            <Separator/>

            <Label text="All Bookings" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <ListView fx:id="bookingsListView" prefHeight="150" prefWidth="450"/>
            <Button text="Refresh Bookings" onAction="#loadBookings" styleClass="admin-btn"/>

        </VBox>
    </center>

</BorderPane>