<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.parking.client.controller.ForgotPasswordController"
           style="-fx-background-color: #f8fafc;">

    <VBox alignment="CENTER" spacing="16" styleClass="auth-card" maxWidth="380">
        <padding>
            <Insets top="10" bottom="10"/>
        </padding>

        <VBox alignment="CENTER" spacing="8">
            <HBox styleClass="brand-badge" alignment="CENTER">
                <Label text="🅿" styleClass="brand-icon"/>
            </HBox>
            <Label text="ParkEase" styleClass="brand-wordmark"/>
        </VBox>

        <Label text="Forgot Password" styleClass="auth-title"/>
        <Label text="Enter your email to receive an OTP" styleClass="auth-subtitle" wrapText="true"/>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="EMAIL" styleClass="auth-field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #dc2626; -fx-font-size: 12px;" text="" wrapText="true"/>

        <Button text="Send OTP" onAction="#handleSendOtp" maxWidth="Infinity"/>

        <Label text="Back to Login" styleClass="auth-link" onMouseClicked="#goToLogin"/>

    </VBox>

</StackPane>