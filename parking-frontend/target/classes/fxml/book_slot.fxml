<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.BookSlotController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="18" styleClass="content-area">
            <padding>
                <Insets top="24" right="30" bottom="24" left="30"/>
            </padding>

            <Label styleClass="topbar-title" text="Book a Parking Slot"/>
            <Label styleClass="topbar-subtitle" text="Select your vehicle, then tap a green slot to reserve it"/>

            <VBox styleClass="panel-card" spacing="14">
                <Label styleClass="panel-title" text="1. Select Vehicle"/>
                <ComboBox fx:id="vehicleCombo" promptText="Choose your vehicle" maxWidth="320"/>
                <Button text="Check Available Slots" onAction="#handleCheckSlots"/>
            </VBox>

            <VBox styleClass="panel-card" spacing="14">
                <Label styleClass="panel-title" text="2. Choose a Slot"/>
                <FlowPane fx:id="slotGridPane" styleClass="slot-grid"/>

                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c;" text=""/>
                <Label fx:id="successLabel" style="-fx-text-fill: #2ecc71;" text=""/>

                <Button text="Book Selected Slot" onAction="#handleBookSlot" styleClass="customer-btn"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>