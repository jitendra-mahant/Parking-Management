<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.parking.client.controller.BookSlotController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Book a Parking Slot" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Select Vehicle"/>
    <ComboBox fx:id="vehicleCombo" promptText="Choose your vehicle" maxWidth="300"/>

    <Button text="Check Available Slots" onAction="#handleCheckSlots"/>

    <Label text="Available Slots"/>
    <ListView fx:id="slotListView" prefHeight="150" prefWidth="300"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" text=""/>
    <Label fx:id="successLabel" style="-fx-text-fill: green;" text=""/>

    <Button text="Book Selected Slot" onAction="#handleBookSlot"/>

    <Button text="Back to Dashboard" onAction="#goToDashboard"/>
</VBox>