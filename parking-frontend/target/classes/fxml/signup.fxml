<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.parking.client.controller.SignupController"
           style="-fx-background-color: #f0f2f7;">

    <VBox alignment="CENTER" spacing="14" styleClass="auth-card" maxWidth="380">
        <padding>
            <Insets top="10" bottom="10"/>
        </padding>

        <HBox styleClass="brand-badge" alignment="CENTER">
            <Label text="P"/>
        </HBox>

        <Label text="Create your account" styleClass="auth-title"/>
        <Label text="Sign up to start booking parking" styleClass="auth-subtitle"/>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="FULL NAME" styleClass="auth-field-label"/>
            <TextField fx:id="nameField" promptText="Enter your name" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="EMAIL" styleClass="auth-field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="PHONE" styleClass="auth-field-label"/>
            <TextField fx:id="phoneField" promptText="10-digit number" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="PASSWORD" styleClass="auth-field-label"/>
            <PasswordField fx:id="passwordField" promptText="Create a password" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="CONFIRM PASSWORD" styleClass="auth-field-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Re-enter password" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" text="" wrapText="true"/>

        <Button text="Sign Up" onAction="#handleSignup" maxWidth="Infinity"/>

        <HBox alignment="CENTER" spacing="4">
            <Label text="Already have an account?" style="-fx-font-size: 12px; -fx-text-fill: #8891a5;"/>
            <Label text="Log in" styleClass="auth-link" onMouseClicked="#goToLogin"/>
        </HBox>

    </VBox>

</StackPane>