<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Separator?>

<VBox alignment="TOP_CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.parking.client.controller.ProfileController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="My Profile" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label text="Name"/>
    <TextField fx:id="nameField" maxWidth="250"/>

    <Label text="Email (cannot be changed)"/>
    <TextField fx:id="emailField" maxWidth="250" disable="true"/>

    <Label text="Phone"/>
    <TextField fx:id="phoneField" maxWidth="250"/>

    <Label fx:id="profileErrorLabel" style="-fx-text-fill: red;" text=""/>
    <Label fx:id="profileSuccessLabel" style="-fx-text-fill: green;" text=""/>

    <Button text="Save Changes" onAction="#handleUpdateProfile"/>

    <Separator/>

    <Label text="Change Password" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <PasswordField fx:id="currentPasswordField" promptText="Current password" maxWidth="250"/>
    <PasswordField fx:id="newPasswordField" promptText="New password" maxWidth="250"/>

    <Label fx:id="passwordErrorLabel" style="-fx-text-fill: red;" text=""/>
    <Label fx:id="passwordSuccessLabel" style="-fx-text-fill: green;" text=""/>

    <Button text="Change Password" onAction="#handleChangePassword"/>

    <Button text="Back to Dashboard" onAction="#goToDashboard"/>
</VBox>