<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.parking.client.controller.DashboardController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

   <HBox styleClass="header-bar, customer-header" alignment="CENTER" maxWidth="Infinity">
    <Label fx:id="welcomeLabel" text="Welcome!"/>
</HBox>
    <Button text="My Vehicles" onAction="#goToVehicles"/>
    <Label fx:id="roleLabel" style="-fx-font-size: 14px; -fx-text-fill: gray;" text=""/>

    <Button text="Logout" onAction="#handleLogout" styleClass="customer-btn"/>
</VBox>