<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.DashboardController">

    <!-- Sidebar Navigation -->
    <left>
        <VBox styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 4 6 18 6;">
                <HBox styleClass="brand-badge" alignment="CENTER" style="-fx-min-width: 38px; -fx-min-height: 38px; -fx-max-width: 38px; -fx-max-height: 38px;">
                    <SVGPath content="M9 21V5h5a4 4 0 0 1 0 8H9" style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2.2; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                </HBox>
                <VBox spacing="1">
                    <Label text="ParkEase" styleClass="sidebar-brand"/>
                    <Label text="CUSTOMER PORTAL" styleClass="sidebar-brand-sub"/>
                </VBox>
            </HBox>

            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M3 3h7v9H3zm11 0h7v5h-7zm0 9h7v9h-7zM3 16h7v5H3z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M9 21V5h5a4 4 0 0 1 0 8H9" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-7 0V2m-6 2V2m-2 7h18" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M5 17h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2l-2-4H9L7 7H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2zm1 0v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2zm10 0v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M2 7h20M2 11h20M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9 M13.73 21a2 2 0 0 1-3.46 0" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Current Session Profile Card in Sidebar -->
            <HBox styleClass="sidebar-user-card" alignment="CENTER_LEFT" spacing="10">
                <HBox styleClass="avatar-circle, avatar-customer" style="-fx-min-width: 34px; -fx-min-height: 34px; -fx-max-width: 34px; -fx-max-height: 34px;">
                    <Label fx:id="avatarLabel" text="U" style="-fx-font-size: 13px; -fx-font-weight: 800; -fx-text-fill: white;"/>
                </HBox>
                <VBox spacing="1">
                    <Label fx:id="sidebarUserName" text="Customer" style="-fx-text-fill: white; -fx-font-weight: 700; -fx-font-size: 12.5px;"/>
                    <Label fx:id="sidebarUserRole" text="CUSTOMER" style="-fx-text-fill: #0F9D8A; -fx-font-weight: 800; -fx-font-size: 10px;"/>
                </VBox>
            </HBox>

            <Button text="Sign Out" onAction="#handleLogout" styleClass="sidebar-btn, sidebar-btn-logout" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox alignment="TOP_LEFT" spacing="20" styleClass="content-area">
            <padding>
                <Insets top="20" right="28" bottom="24" left="28"/>
            </padding>

            <!-- Topbar Header -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="3">
                    <Label fx:id="welcomeLabel" styleClass="topbar-title" text="Welcome back!"/>
                    <Label styleClass="topbar-subtitle" text="Customer Dashboard | Live Parking Status &amp; Bookings"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="live-pill" alignment="CENTER">
                    <Label text="● System Online"/>
                </HBox>
                <HBox styleClass="role-chip, chip-customer">
                    <Label fx:id="roleLabel" text="CUSTOMER"/>
                </HBox>
                <Button text="Book a Slot" onAction="#goToBookSlot" styleClass="customer-btn" style="-fx-font-size: 12px; -fx-padding: 7 16 7 16;"/>
            </HBox>

            <!-- 4 Modern Metric / KPI Cards -->
            <HBox styleClass="stats-row">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-label" text="ACTIVE SESSIONS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <SVGPath content="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zm0-15v5l3 3" style="-fx-fill: #0F9D8A;"/>
                    </HBox>
                    <Label fx:id="activeBookingsLabel" styleClass="stat-number" text="0"/>
                    <Label styleClass="stat-subtext" text="Currently parked or upcoming"/>
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-label" text="TOTAL BOOKINGS"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <SVGPath content="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z" style="-fx-fill: #14213D;"/>
                    </HBox>
                    <Label fx:id="totalBookingsLabel" styleClass="stat-number" text="0"/>
                    <Label styleClass="stat-subtext" text="Lifetime reservations made"/>
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-label" text="TOTAL SPENT"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <SVGPath content="M2 7h20M2 11h20M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2z" style="-fx-fill: #21865B;"/>
                    </HBox>
                    <Label fx:id="totalSpentLabel" styleClass="stat-number" text="₹0"/>
                    <Label styleClass="stat-subtext" text="Paid for completed parking"/>
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="stat-label" text="REGISTERED VEHICLES"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <SVGPath content="M5 17h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2l-2-4H9L7 7H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2z" style="-fx-fill: #D99116;"/>
                    </HBox>
                    <Label fx:id="vehiclesCountLabel" styleClass="stat-number" text="0"/>
                    <Label styleClass="stat-subtext" text="Vehicles linked to profile"/>
                </VBox>
            </HBox>

            <!-- Split Section: Quick Actions + Transparent Rates -->
            <HBox spacing="18">
                <!-- Action Banner -->
                <VBox styleClass="panel-card" spacing="12" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF;">
                    <Label styleClass="panel-title" text="Quick Operations"/>
                    <Label styleClass="topbar-subtitle" text="Reserve a guaranteed spot or manage your active bookings with one tap." wrapText="true"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Reserve Slot Now" onAction="#goToBookSlot" styleClass="customer-btn"/>
                        <Button text="View All Bookings" onAction="#goToMyBookings" styleClass="btn-secondary"/>
                        <Button text="Manage Vehicles" onAction="#goToVehicles" styleClass="btn-secondary"/>
                    </HBox>
                </VBox>

                <!-- Standard Pricing Guide -->
                <VBox styleClass="panel-card" spacing="8" prefWidth="340" style="-fx-background-color: #F8FAFC;">
                    <Label styleClass="panel-title" text="Facility Rates (Transparent Hourly)"/>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🚗 Car Zone:" style="-fx-font-weight: 700; -fx-font-size: 12px;"/>
                        <Label text="₹40 / hr" style="-fx-text-fill: #0F9D8A; -fx-font-weight: 800; -fx-font-size: 13px;"/>
                        <Label text="(Slots A1–A12)" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🏍️ Two-Wheeler:" style="-fx-font-weight: 700; -fx-font-size: 12px;"/>
                        <Label text="₹20 / hr" style="-fx-text-fill: #0F9D8A; -fx-font-weight: 800; -fx-font-size: 13px;"/>
                        <Label text="(Slots B1–B8)" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🚚 Heavy/Truck:" style="-fx-font-weight: 700; -fx-font-size: 12px;"/>
                        <Label text="₹80 / hr" style="-fx-text-fill: #0F9D8A; -fx-font-weight: 800; -fx-font-size: 13px;"/>
                        <Label text="(Slots T1–T4)" style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Recent Bookings Table -->
            <VBox styleClass="panel-card" spacing="12">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label styleClass="panel-title" text="Recent Parking Activity"/>
                        <Label styleClass="topbar-subtitle" text="Your latest parking reservations and check-out records"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="View Complete History →" onAction="#goToMyBookings" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 6 12 6 12;"/>
                </HBox>

                <TableView fx:id="recentBookingsTable" prefHeight="200">
                    <columns>
                        <TableColumn fx:id="colRecentSlot" text="Slot" prefWidth="75"/>
                        <TableColumn fx:id="colRecentVehicle" text="Vehicle Number" prefWidth="150"/>
                        <TableColumn fx:id="colRecentCheckIn" text="Check-In" prefWidth="160"/>
                        <TableColumn fx:id="colRecentCheckOut" text="Expected Exit" prefWidth="160"/>
                        <TableColumn fx:id="colRecentStatus" text="Status" prefWidth="110"/>
                        <TableColumn fx:id="colRecentFare" text="Fare" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No parking reservations recorded yet. Book your first slot above!" style="-fx-text-fill: #64748B; -fx-font-size: 12.5px;"/>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>
