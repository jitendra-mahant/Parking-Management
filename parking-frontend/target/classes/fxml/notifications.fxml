<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.NotificationsController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Notifications" onAction="#goToNotifications" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="12" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Notifications"/>

            <ListView fx:id="notificationsListView" prefHeight="400" prefWidth="500"/>

            <Button text="Mark Selected as Read" onAction="#handleMarkAsRead"/>
            <Button text="Refresh" onAction="#loadNotifications"/>

            <Label fx:id="statusLabel" text=""/>
        </VBox>
    </center>

</BorderPane>