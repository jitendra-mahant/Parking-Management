<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.parking.client.controller.ResetPasswordController"
           style="-fx-background-color: #f0f2f7;">

    <VBox alignment="CENTER" spacing="16" styleClass="auth-card" maxWidth="380">
        <padding>
            <Insets top="10" bottom="10"/>
        </padding>

        <HBox styleClass="brand-badge" alignment="CENTER">
            <Label text="P"/>
        </HBox>

        <Label text="Reset Password" styleClass="auth-title"/>
        <Label text="Choose a new password for your account" styleClass="auth-subtitle" wrapText="true"/>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="NEW PASSWORD" styleClass="auth-field-label"/>
            <PasswordField fx:id="newPasswordField" promptText="Enter new password" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="CONFIRM PASSWORD" styleClass="auth-field-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" text="" wrapText="true"/>

        <Button text="Reset Password" onAction="#handleResetPassword" maxWidth="Infinity"/>

    </VBox>

</StackPane>