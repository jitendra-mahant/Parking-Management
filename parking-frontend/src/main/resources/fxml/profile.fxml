<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.ProfileController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Profile" onAction="#goToProfile" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button fx:id="saveProfileButton" text="Save Changes" onAction="#handleUpdateProfile" styleClass="customer-btn"/>
            <Button fx:id="changePasswordButton" text="Change Password" onAction="#handleChangePassword" styleClass="customer-btn"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="18" styleClass="content-area">
            <padding>
                <Insets top="24" right="30" bottom="24" left="30"/>
            </padding>

            <Label styleClass="topbar-title" text="My Profile"/>
            <Label styleClass="topbar-subtitle" text="Manage your personal information and account security"/>

            <VBox styleClass="panel-card" spacing="10" alignment="TOP_CENTER">
                <ImageView fx:id="profileImageView" fitWidth="100" fitHeight="100"/>
                <Button text="Upload Photo" onAction="#handleUploadPhoto"/>
                <Label fx:id="photoStatusLabel" style="-fx-text-fill: #2ecc71; -fx-font-size: 11px;" text=""/>
            </VBox>

            <VBox styleClass="panel-card" spacing="10">
                <Label styleClass="panel-title" text="Personal Information"/>

                <Label text="Name" style="-fx-font-size: 12px; -fx-text-fill: #5a6478;"/>
                <TextField fx:id="nameField" maxWidth="320"/>

                <Label text="Email (cannot be changed)" style="-fx-font-size: 12px; -fx-text-fill: #5a6478;"/>
                <TextField fx:id="emailField" maxWidth="320" disable="true"/>

                <Label text="Phone" style="-fx-font-size: 12px; -fx-text-fill: #5a6478;"/>
                <TextField fx:id="phoneField" maxWidth="320"/>

                <Label text="Address" style="-fx-font-size: 12px; -fx-text-fill: #5a6478;"/>
                <TextField fx:id="addressField" promptText="Enter your address" maxWidth="320"/>

                <Label fx:id="profileErrorLabel" style="-fx-text-fill: #e74c3c;" text=""/>
                <Label fx:id="profileSuccessLabel" style="-fx-text-fill: #2ecc71;" text=""/>

                <Button text="Save Changes" onAction="#handleUpdateProfile" styleClass="customer-btn"/>
            </VBox>

            <VBox styleClass="panel-card" spacing="10">
                <Label styleClass="panel-title" text="Change Password"/>

                <PasswordField fx:id="currentPasswordField" promptText="Current password" maxWidth="320"/>
                <PasswordField fx:id="newPasswordField" promptText="New password" maxWidth="320"/>

                <Label fx:id="passwordErrorLabel" style="-fx-text-fill: #e74c3c;" text=""/>
                <Label fx:id="passwordSuccessLabel" style="-fx-text-fill: #2ecc71;" text=""/>

                <Button text="Change Password" onAction="#handleChangePassword" styleClass="customer-btn"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>