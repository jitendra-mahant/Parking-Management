<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.SettingsController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="Settings" onAction="#goToSettings" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="18" styleClass="content-area">
            <padding>
                <Insets top="24" right="30" bottom="24" left="30"/>
            </padding>

            <Label styleClass="topbar-title" text="Settings"/>
            <Label styleClass="topbar-subtitle" text="Customize your app experience"/>

            <VBox styleClass="panel-card" spacing="12">
                <Label styleClass="panel-title" text="Appearance"/>
                <CheckBox fx:id="darkModeCheckBox" text="Dark Theme"/>

                <Label styleClass="panel-title" text="Language"/>
                <ComboBox fx:id="languageCombo" promptText="Select Language" maxWidth="260"/>
                <Label text="(Coming soon - display only for now)" style="-fx-text-fill: gray; -fx-font-size: 11px;"/>

                <Label fx:id="statusLabel" style="-fx-text-fill: #2ecc71;" text=""/>

                <Button text="Apply Changes" onAction="#handleApply" styleClass="customer-btn"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>