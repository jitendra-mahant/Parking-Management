<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.StaffDashboardController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn, sidebar-btn-staff-active" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="12" styleClass="content-area">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label fx:id="welcomeLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Staff Dashboard"/>

            <Label text="Vehicle Entry" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <TextField fx:id="entryVehicleNumberField" promptText="Vehicle Number" maxWidth="250"/>
            <ComboBox fx:id="entryVehicleTypeCombo" promptText="Vehicle Type" maxWidth="250"/>
            <Button text="Record Entry" onAction="#handleRecordEntry" styleClass="staff-btn"/>

            <Label fx:id="entryStatusLabel" text=""/>

            <Separator/>

            <Label text="Active Bookings" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <ListView fx:id="activeBookingsListView" prefHeight="180" prefWidth="450"/>
            <Button text="Record Exit for Selected" onAction="#handleRecordExit" styleClass="staff-btn"/>
            <Button text="Refresh Active Bookings" onAction="#loadActiveBookings" styleClass="staff-btn"/>

            <Label fx:id="exitStatusLabel" text=""/>

            <Separator/>

            <Label text="All Slots Status" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
            <ListView fx:id="slotsListView" prefHeight="150" prefWidth="450"/>
            <Button text="Refresh Slots" onAction="#loadSlots" styleClass="staff-btn"/>

        </VBox>
    </center>

</BorderPane>