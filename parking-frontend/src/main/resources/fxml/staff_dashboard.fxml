<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.StaffDashboardController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn, sidebar-btn-staff-active" maxWidth="Infinity"/>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="20" styleClass="content-area">
            <padding>
                <Insets top="24" right="30" bottom="24" left="30"/>
            </padding>

            <HBox styleClass="topbar">
                <HBox styleClass="avatar-circle, avatar-staff">
                    <Label fx:id="avatarLabel" text="S"/>
                </HBox>
                <VBox spacing="4">
                    <Label fx:id="welcomeLabel" styleClass="topbar-title" text="Staff Dashboard"/>
                    <Label styleClass="topbar-subtitle" text="Manage vehicle entries, exits, and slot status"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="role-chip, chip-staff">
                    <Label text="STAFF"/>
                </HBox>
            </HBox>

            <HBox styleClass="stats-row">
                <VBox styleClass="stat-card">
                    <Label fx:id="totalSlotsLabel" styleClass="stat-number" text="0"/>
                    <Label styleClass="stat-label" text="TOTAL SLOTS"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label fx:id="occupiedSlotsLabel" styleClass="stat-number" text="0"/>
                    <Label styleClass="stat-label" text="OCCUPIED"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label fx:id="availableSlotsLabel" styleClass="stat-number" text="0"/>
                    <Label styleClass="stat-label" text="AVAILABLE"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label fx:id="todayEntriesLabel" styleClass="stat-number" text="0"/>
                    <Label styleClass="stat-label" text="TODAY ENTRIES"/>
                </VBox>
                <VBox styleClass="stat-card">
                    <Label fx:id="todayExitsLabel" styleClass="stat-number" text="0"/>
                    <Label styleClass="stat-label" text="TODAY EXITS"/>
                </VBox>
            </HBox>

            <VBox styleClass="panel-card" spacing="12">
                <Label styleClass="panel-title" text="Live Parking Layout"/>
                <FlowPane fx:id="slotGridPane" styleClass="slot-grid"/>
            </VBox>

            <HBox spacing="20">
                <VBox styleClass="panel-card" spacing="10" HBox.hgrow="ALWAYS">
                    <Label styleClass="panel-title" text="Vehicle Entry"/>
                    <TextField fx:id="entryVehicleNumberField" promptText="Vehicle Number" maxWidth="Infinity"/>
                    <ComboBox fx:id="entryVehicleTypeCombo" promptText="Vehicle Type" maxWidth="Infinity"/>
                    <Button text="Record Entry" onAction="#handleRecordEntry" styleClass="staff-btn"/>
                    <Label fx:id="entryStatusLabel" text=""/>
                </VBox>

                <VBox styleClass="panel-card" spacing="10" HBox.hgrow="ALWAYS">
                    <Label styleClass="panel-title" text="Active Bookings"/>
                    <ListView fx:id="activeBookingsListView" prefHeight="150"/>
                    <Button text="Record Exit for Selected" onAction="#handleRecordExit" styleClass="staff-btn"/>
                    <Button text="Refresh All" onAction="#refreshAll" styleClass="staff-btn"/>
                    <Label fx:id="exitStatusLabel" text=""/>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>