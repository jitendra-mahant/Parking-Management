<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.MyBookingsController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="🏠  Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="👤  My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🚗  My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🅿️  Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="📋  My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="💳  Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🔔  Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="⚙️  Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🚪  Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="20" styleClass="content-area">
            <padding>
                <Insets top="24" right="30" bottom="24" left="30"/>
            </padding>

            <Label styleClass="topbar-title" text="My Bookings"/>
            <Label styleClass="topbar-subtitle" text="Track active parking and view past history"/>

            <VBox styleClass="panel-card" spacing="12">
                <TabPane prefHeight="360">
                    <Tab text="Active" closable="false">
                        <VBox spacing="10">
                            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                            <TableView fx:id="activeTable" prefHeight="280">
                                <columns>
                                    <TableColumn fx:id="colActiveSlot" text="Slot" prefWidth="90"/>
                                    <TableColumn fx:id="colActiveVehicle" text="Vehicle" prefWidth="140"/>
                                    <TableColumn fx:id="colActiveEntry" text="Entry Time" prefWidth="180"/>
                                    <TableColumn fx:id="colActiveAction" text="Actions" prefWidth="200"/>
                                </columns>
                                <placeholder>
                                    <Label text="No active bookings right now"/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </Tab>
                    <Tab text="History" closable="false">
    <VBox spacing="10">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <TextField fx:id="historySearchField" promptText="Search by vehicle number..." maxWidth="Infinity"/>
        <TableView fx:id="historyTable" prefHeight="280">
                                <columns>
                                    <TableColumn fx:id="colHistSlot" text="Slot" prefWidth="80"/>
                                    <TableColumn fx:id="colHistVehicle" text="Vehicle" prefWidth="130"/>
                                    <TableColumn fx:id="colHistStatus" text="Status" prefWidth="110"/>
                                    <TableColumn fx:id="colHistFare" text="Fare" prefWidth="90"/>
                                    <TableColumn fx:id="colHistAction" text="Receipt" prefWidth="110"/>
                                </columns>
                                <placeholder>
                                    <Label text="No booking history yet"/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </Tab>
                </TabPane>

                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c;" text=""/>
                <Label fx:id="successLabel" style="-fx-text-fill: #2ecc71;" text=""/>

                <Button text="Refresh" onAction="#loadBookings"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>