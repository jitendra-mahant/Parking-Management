<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.MyBookingsController">

    <left>
        <VBox styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 18 12;">
                <Label text="🅿" style="-fx-font-size: 18px; -fx-text-fill: #2563eb;"/>
                <Label text="ParkEase" style="-fx-font-size: 17px; -fx-font-weight: 800; -fx-text-fill: #1e293b;"/>
            </HBox>
            <Button text="🏠  Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="👤  My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🚗  My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🅿️  Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="📋  My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="💳  Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🔔  Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="⚙️  Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🚪  Logout" onAction="#handleLogout" styleClass="sidebar-btn, sidebar-btn-logout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="20" styleClass="content-area">
            <padding>
                <Insets top="24" right="30" bottom="24" left="30"/>
            </padding>

            <Label styleClass="topbar-title" text="My Bookings"/>
            <Label styleClass="topbar-subtitle" text="Track active parking and view past history"/>

            <VBox styleClass="panel-card" spacing="10">
                <TabPane prefHeight="360">
                    <Tab text="Active" closable="false">
                        <VBox spacing="10">
                            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                            <TableView fx:id="activeTable" prefHeight="280">
                                <columns>
                                    <TableColumn fx:id="colActiveSlot" text="Slot" prefWidth="70"/>
                                    <TableColumn fx:id="colActiveVehicle" text="Vehicle" prefWidth="120"/>
                                    <TableColumn fx:id="colActiveEntry" text="Entry Time" prefWidth="140"/>
                                    <TableColumn fx:id="colActiveExpected" text="Expected Until" prefWidth="140"/>
                                    <TableColumn fx:id="colActiveAction" text="Actions" prefWidth="250"/>
                                </columns>
                                <placeholder>
                                    <Label text="No active bookings right now"/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </Tab>
                    <Tab text="History" closable="false">
                        <VBox spacing="10">
                            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                            <TextField fx:id="historySearchField" promptText="Search by vehicle number..." maxWidth="Infinity"/>
                            <TableView fx:id="historyTable" prefHeight="250">
                                <columns>
                                    <TableColumn fx:id="colHistSlot" text="Slot" prefWidth="60"/>
                                    <TableColumn fx:id="colHistVehicle" text="Vehicle" prefWidth="110"/>
                                    <TableColumn fx:id="colHistStatus" text="Status" prefWidth="90"/>
                                    <TableColumn fx:id="colHistFare" text="Fare" prefWidth="75"/>
                                    <TableColumn fx:id="colHistRating" text="Rating" prefWidth="100"/>
                                    <TableColumn fx:id="colHistAction" text="" prefWidth="190"/>
                                </columns>
                                <placeholder>
                                    <Label text="No booking history yet"/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </Tab>
                </TabPane>

                <Label fx:id="errorLabel" style="-fx-text-fill: #dc2626;" text=""/>
                <Label fx:id="successLabel" style="-fx-text-fill: #15803d;" text=""/>

                <Button text="Refresh" onAction="#loadBookings"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>