<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.parking.client.controller.ForgotPasswordController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Forgot Password" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Enter your registered email to receive an OTP"/>

    <TextField fx:id="emailField" promptText="Enter your email" maxWidth="250"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" text=""/>

    <Button text="Send OTP" onAction="#handleSendOtp"/>
    <Label text="Back to Login" style="-fx-text-fill: blue; -fx-underline: true;" onMouseClicked="#goToLogin"/>
</VBox>