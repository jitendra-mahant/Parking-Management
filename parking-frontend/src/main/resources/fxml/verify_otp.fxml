<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.parking.client.controller.VerifyOtpController"
           style="-fx-background-color: #F5F7FA;">

    <VBox alignment="CENTER" spacing="16" styleClass="auth-card" maxWidth="420">
        <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
        </padding>

        <VBox alignment="CENTER" spacing="6">
            <HBox styleClass="brand-badge" alignment="CENTER">
                <SVGPath content="M9 21V5h5a4 4 0 0 1 0 8H9" style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2.5; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
            </HBox>
            <Label text="ParkEase Enterprise" styleClass="brand-wordmark"/>
            <Label text="SECURITY VERIFICATION" styleClass="brand-tagline"/>
        </VBox>

        <VBox alignment="CENTER" spacing="4">
            <Label text="Verify Code" styleClass="auth-title"/>
            <Label fx:id="infoLabel" text="Enter the 6-digit verification code sent to your email" styleClass="auth-subtitle" wrapText="true"/>
        </VBox>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="6-DIGIT CODE" styleClass="auth-field-label"/>
            <TextField fx:id="otpField" promptText="Enter code" maxWidth="Infinity" style="-fx-alignment: center; -fx-font-size: 16px; -fx-font-weight: bold; -fx-letter-spacing: 4px;"/>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #D64545; -fx-font-size: 12px; -fx-font-weight: bold;" text="" wrapText="true"/>

        <Button text="Verify &amp; Continue" onAction="#handleVerifyOtp" maxWidth="Infinity" style="-fx-pref-height: 40px;"/>

    </VBox>

</StackPane>
