<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.parking.client.controller.VerifyOtpController"
           style="-fx-background-color: #f0f2f7;">

    <VBox alignment="CENTER" spacing="16" styleClass="auth-card" maxWidth="380">
        <padding>
            <Insets top="10" bottom="10"/>
        </padding>

        <HBox styleClass="brand-badge" alignment="CENTER">
            <Label text="P"/>
        </HBox>

        <Label text="Verify OTP" styleClass="auth-title"/>
        <Label fx:id="infoLabel" text="Enter the 6-digit code sent to your email" styleClass="auth-subtitle" wrapText="true"/>

        <VBox spacing="6" maxWidth="Infinity">
            <Label text="OTP CODE" styleClass="auth-field-label"/>
            <TextField fx:id="otpField" promptText="6-digit code" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" text="" wrapText="true"/>

        <Button text="Verify OTP" onAction="#handleVerifyOtp" maxWidth="Infinity"/>

    </VBox>

</StackPane>