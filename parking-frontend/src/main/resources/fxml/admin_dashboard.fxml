<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>

<BorderPane xmlns="http://javafx.com/javafx" 
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.AdminDashboardController"
            stylesheets="@../css/admin_dashboard.css"
            styleClass="main-layout">

    <left>
        <VBox styleClass="sidebar" prefWidth="250">
            <Label text="🅿️ Parking System" styleClass="sidebar-brand"/>
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn, sidebar-btn-admin-active" maxWidth="Infinity"/>
            </VBox>
            <Button text="Logout" onAction="#handleLogout" styleClass="sidebar-btn, sidebar-btn-logout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="24" styleClass="content-area">
            <padding>
                <Insets top="28" right="36" bottom="28" left="36"/>
            </padding>

            <!-- Admin Header Bar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <HBox styleClass="avatar-circle, avatar-admin" alignment="CENTER">
                    <Label fx:id="avatarLabel" text="A" styleClass="avatar-text"/>
                </HBox>
                <VBox spacing="4">
                    <Label fx:id="welcomeLabel" styleClass="topbar-title" text="Admin Dashboard"/>
                    <Label styleClass="topbar-subtitle" text="Manage staff, monitor bookings, and track revenue"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox styleClass="role-chip, chip-admin" alignment="CENTER">
                    <Label text="ADMIN"/>
                </HBox>
            </HBox>

            <!-- Revenue Overview Card -->
            <VBox styleClass="panel-card" spacing="14">
                <Label styleClass="panel-title" text="Revenue Overview"/>
                <Label fx:id="revenueLabel" styleClass="stat-number, stat-number-accent" text="Loading..."/>
                <HBox>
                    <Button text="Refresh Report 🔄" onAction="#loadRevenue" styleClass="admin-btn"/>
                </HBox>
            </VBox>

            <!-- Management Sections -->
                    <VBox styleClass="panel-card" spacing="10" HBox.hgrow="ALWAYS">
                    <Label styleClass="panel-title" text="Manage Staff"/>
                    <TextField fx:id="staffNameField" promptText="Name" maxWidth="Infinity"/>
                    <TextField fx:id="staffEmailField" promptText="Email" maxWidth="Infinity"/>
                    <PasswordField fx:id="staffPasswordField" promptText="Password" maxWidth="Infinity"/>
                    <TextField fx:id="staffPhoneField" promptText="Phone" maxWidth="Infinity"/>
                    <Button text="Add Staff" onAction="#handleAddStaff" styleClass="admin-btn"/>
                    <Label fx:id="staffStatusLabel" text=""/>
                    <TableView fx:id="staffTable" prefHeight="180">
                        <columns>
                            <TableColumn fx:id="colStaffName" text="Name" prefWidth="130"/>
                            <TableColumn fx:id="colStaffEmail" text="Email" prefWidth="160"/>
                            <TableColumn fx:id="colStaffPhone" text="Phone" prefWidth="100"/>
                            <TableColumn fx:id="colStaffDelete" text="" prefWidth="80"/>
                        </columns>
                        <placeholder>
                            <Label text="No staff added yet"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <VBox styleClass="panel-card" spacing="10" HBox.hgrow="ALWAYS">
    <Label styleClass="panel-title" text="All Bookings"/>
    <TextField fx:id="bookingSearchField" promptText="Search by vehicle number..." maxWidth="Infinity"/>
    <TableView fx:id="bookingsTable" prefHeight="330">
                        <columns>
                            <TableColumn fx:id="colBookSlot" text="Slot" prefWidth="70"/>
                            <TableColumn fx:id="colBookVehicle" text="Vehicle" prefWidth="120"/>
                            <TableColumn fx:id="colBookStatus" text="Status" prefWidth="100"/>
                            <TableColumn fx:id="colBookFare" text="Fare" prefWidth="90"/>
                        </columns>
                        <placeholder>
                            <Label text="No bookings yet"/>
                        </placeholder>
                    </TableView>
                                        <HBox spacing="10">
                        <Button text="Refresh Bookings" onAction="#loadBookings" styleClass="admin-btn"/>
                        <Button text="Export to CSV" onAction="#handleExportCsv" styleClass="admin-btn"/>
                    </HBox>
                </VBox>
                <Button text="🏠  Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn, sidebar-btn-admin-active" maxWidth="Infinity"/>
<Button text="🚪  Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>