<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.NotificationsController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="🏠  Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="👤  My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🚗  My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🅿️  Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="📋  My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="💳  Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🔔  Notifications" onAction="#goToNotifications" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="⚙️  Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🚪  Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="20" styleClass="content-area">
            <padding>
                <Insets top="24" right="30" bottom="24" left="30"/>
            </padding>

            <Label styleClass="topbar-title" text="Notifications"/>
            <Label styleClass="topbar-subtitle" text="Booking confirmations, updates, and alerts"/>

            <VBox styleClass="panel-card" spacing="12">
                <TableView fx:id="notifTable" prefHeight="400">
                    <columns>
                        <TableColumn fx:id="colStatus" text="" prefWidth="40"/>
                        <TableColumn fx:id="colMessage" text="Message" prefWidth="380"/>
                        <TableColumn fx:id="colTime" text="Received" prefWidth="160"/>
                        <TableColumn fx:id="colNotifAction" text="" prefWidth="110"/>
                    </columns>
                    <placeholder>
                        <Label text="No notifications yet"/>
                    </placeholder>
                </TableView>
                <Button text="Refresh" onAction="#loadNotifications"/>
                <Label fx:id="statusLabel" text=""/>
            </VBox>

        </VBox>
    </center>

</BorderPane>