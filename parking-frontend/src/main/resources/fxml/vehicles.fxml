<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.VehicleController">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 4 6 18 6;">
                <HBox styleClass="brand-badge" alignment="CENTER" style="-fx-min-width: 38px; -fx-min-height: 38px; -fx-max-width: 38px; -fx-max-height: 38px;">
                    <SVGPath content="M9 21V5h5a4 4 0 0 1 0 8H9" style="-fx-fill: transparent; -fx-stroke: white; -fx-stroke-width: 2.2; -fx-stroke-line-cap: round; -fx-stroke-line-join: round;"/>
                </HBox>
                <VBox spacing="1">
                    <Label text="ParkEase" styleClass="sidebar-brand"/>
                    <Label text="CUSTOMER PORTAL" styleClass="sidebar-brand-sub"/>
                </VBox>
            </HBox>

            <Button text="Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M3 3h7v9H3zm11 0h7v5h-7zm0 9h7v9h-7zM3 16h7v5H3z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M9 21V5h5a4 4 0 0 1 0 8H9" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm-7 0V2m-6 2V2m-2 7h18" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M5 17h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2l-2-4H9L7 7H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2zm1 0v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2zm10 0v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M2 7h20M2 11h20M4 3h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9 M13.73 21a2 2 0 0 1-3.46 0" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2 M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
            <Button text="Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" styleClass="sidebar-icon"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Sign Out" onAction="#handleLogout" styleClass="sidebar-btn, sidebar-btn-logout" maxWidth="Infinity">
                <graphic>
                    <SVGPath content="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9" styleClass="sidebar-icon"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <VBox alignment="TOP_LEFT" spacing="20" styleClass="content-area">
            <padding>
                <Insets top="20" right="28" bottom="24" left="28"/>
            </padding>

            <!-- Topbar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="3">
                    <Label styleClass="topbar-title" text="Vehicle Management"/>
                    <Label styleClass="topbar-subtitle" text="Register, inspect, and manage vehicles authorized for parking reservations"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Book Slot For Vehicle" onAction="#goToBookSlot" styleClass="customer-btn" style="-fx-font-size: 12px; -fx-padding: 7 16 7 16;"/>
            </HBox>

            <!-- Split Section: Vehicles Table + Add Vehicle Form -->
            <HBox spacing="18">
                <!-- Registered Vehicles Table Card -->
                <VBox styleClass="panel-card" spacing="12" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="2">
                            <Label styleClass="panel-title" text="My Registered Vehicles"/>
                            <Label styleClass="topbar-subtitle" text="Vehicles associated with your customer account"/>
                        </VBox>
                    </HBox>

                    <TableView fx:id="vehicleTable" prefHeight="280">
                        <columns>
                            <TableColumn fx:id="colVehicleNumber" text="License Plate Number" prefWidth="180"/>
                            <TableColumn fx:id="colVehicleType" text="Vehicle Type" prefWidth="120"/>
                            <TableColumn fx:id="colModel" text="Make &amp; Model" prefWidth="180"/>
                            <TableColumn fx:id="colAction" text="Actions" prefWidth="95"/>
                        </columns>
                        <placeholder>
                            <Label text="No vehicles registered yet. Add your vehicle using the form." style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                        </placeholder>
                    </TableView>
                </VBox>

                <!-- Add New Vehicle Form Card -->
                <VBox styleClass="panel-card" spacing="14" prefWidth="380">
                    <Label styleClass="panel-title" text="Register New Vehicle"/>
                    <Label styleClass="topbar-subtitle" text="Add a car, bike, or truck for instant slot reservations"/>

                    <VBox spacing="5">
                        <Label text="REGISTRATION NUMBER" styleClass="auth-field-label"/>
                        <TextField fx:id="vehicleNumberField" promptText="e.g. MH12AB1234" maxWidth="Infinity" style="-fx-font-weight: bold;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="VEHICLE CATEGORY" styleClass="auth-field-label"/>
                        <ComboBox fx:id="vehicleTypeCombo" promptText="Select category" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="MODEL / MAKE (OPTIONAL)" styleClass="auth-field-label"/>
                        <TextField fx:id="modelField" promptText="e.g. Honda City, Royal Enfield" maxWidth="Infinity"/>
                    </VBox>

                    <Label fx:id="errorLabel" style="-fx-text-fill: #D64545; -fx-font-weight: bold; -fx-font-size: 12px;" text="" wrapText="true"/>
                    <Label fx:id="successLabel" style="-fx-text-fill: #21865B; -fx-font-weight: bold; -fx-font-size: 12px;" text="" wrapText="true"/>

                    <Button fx:id="addVehicleButton" text="Register Vehicle" onAction="#handleAddVehicle" styleClass="customer-btn" maxWidth="Infinity" style="-fx-pref-height: 38px;"/>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>
