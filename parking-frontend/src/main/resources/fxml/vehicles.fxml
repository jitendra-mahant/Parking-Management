<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parking.client.controller.VehicleController">

    <left>
        <VBox styleClass="sidebar">
            <Label text="Parking System"/>
            <Button text="🏠  Dashboard" onAction="#goToDashboard" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="👤  My Profile" onAction="#goToProfile" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🚗  My Vehicles" onAction="#goToVehicles" styleClass="sidebar-btn, sidebar-btn-active" maxWidth="Infinity"/>
            <Button text="🅿️  Book Parking Slot" onAction="#goToBookSlot" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="📋  My Bookings" onAction="#goToMyBookings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="💳  Payments" onAction="#goToPayment" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🔔  Notifications" onAction="#goToNotifications" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="⚙️  Settings" onAction="#goToSettings" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="🚪  Logout" onAction="#handleLogout" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button fx:id="addVehicleButton" text="Add Vehicle" onAction="#handleAddVehicle" styleClass="customer-btn"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="20" styleClass="content-area">
            <padding>
                <Insets top="24" right="30" bottom="24" left="30"/>
            </padding>

            <Label styleClass="topbar-title" text="My Vehicles"/>
            <Label styleClass="topbar-subtitle" text="Add, view, and remove your registered vehicles"/>

            <VBox styleClass="panel-card" spacing="14">
                <Label styleClass="panel-title" text="Registered Vehicles"/>
                <TableView fx:id="vehicleTable" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colVehicleNumber" text="Vehicle Number" prefWidth="170"/>
                        <TableColumn fx:id="colVehicleType" text="Type" prefWidth="110"/>
                        <TableColumn fx:id="colModel" text="Model" prefWidth="180"/>
                        <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="No vehicles added yet"/>
                    </placeholder>
                </TableView>
            </VBox>

            <VBox styleClass="panel-card" spacing="14">
                <Label styleClass="panel-title" text="Add New Vehicle"/>
                <TextField fx:id="vehicleNumberField" promptText="Vehicle Number (e.g. MH12AB1234)" maxWidth="300"/>
                <ComboBox fx:id="vehicleTypeCombo" promptText="Select Vehicle Type" maxWidth="300"/>
                <TextField fx:id="modelField" promptText="Model (optional, e.g. Honda City)" maxWidth="300"/>

                <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c;" text=""/>
                <Label fx:id="successLabel" style="-fx-text-fill: #2ecc71;" text=""/>

                <Button text="Add Vehicle" onAction="#handleAddVehicle" styleClass="customer-btn"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>