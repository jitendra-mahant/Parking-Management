<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.parking.client.controller.VehicleController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="My Vehicles" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <ListView fx:id="vehicleListView" prefHeight="200" prefWidth="400"/>

    <Button text="Delete Selected Vehicle" onAction="#handleDeleteVehicle"/>

    <Label text="Add New Vehicle" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TextField fx:id="vehicleNumberField" promptText="Vehicle Number (e.g. MH12AB1234)" maxWidth="250"/>

    <ComboBox fx:id="vehicleTypeCombo" promptText="Select Vehicle Type" maxWidth="250"/>

    <TextField fx:id="modelField" promptText="Model (optional, e.g. Honda City)" maxWidth="250"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" text=""/>
    <Label fx:id="successLabel" style="-fx-text-fill: green;" text=""/>

    <Button text="Add Vehicle" onAction="#handleAddVehicle"/>

    <Button text="Back to Dashboard" onAction="#goToDashboard"/>
</VBox>